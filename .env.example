# Copy to .env.local for local development. On Vercel, set these under
# Project Settings > Environment Variables.

# Waitlist (/api/waitlist): Cloudflare Turnstile secret for the site key in
# src/app/waitlist/page.tsx.
TURNSTILE_SECRET=

# Waitlist sign-ups are saved as Resend contacts. Create the contact properties
# country, role, products and username (all text) in Resend first.
RESEND_API_KEY=
# Optional: the segment that sign-ups join, e.g. "Waitlist".
RESEND_WAITLIST_SEGMENT_ID=

# Optional: the canonical domain for links, the sitemap and share images.
# Vercel's production domain is used when this is empty.
NEXT_PUBLIC_SITE_URL=
