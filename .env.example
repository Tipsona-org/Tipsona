# Copy to .env.local for local development. On Vercel, set these under
# Project Settings > Environment Variables.

# Waitlist (/api/waitlist): the Cloudflare Turnstile widget's key pair.
# Production uses the real pair from the Turnstile dashboard. Locally and on
# Vercel previews use Cloudflare's always-pass test pair:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# The site key is built into the page, so redeploy after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Waitlist sign-ups are saved as Resend contacts. Create the contact properties
# country, role, products and username (all text) in Resend first.
RESEND_API_KEY=
# Optional: the segment that sign-ups join. Give it a different value per
# environment: the "Waitlist" segment in Production, a "Waitlist (test)"
# segment in Preview.
RESEND_WAITLIST_SEGMENT_ID=

# Optional: the canonical domain for links, the sitemap and share images.
# Vercel's production domain is used when this is empty.
NEXT_PUBLIC_SITE_URL=
